{
  "name": "bmxt_demo",
  "displayName": "__MSG_extensionName__",
  "version": "0.8.8",
  "license": "Apache-2.0",
  "description": "__MSG_extensionDescription__",
  "author": "UNRsports",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "repository": {
    "type": "git",
    "url": "https://github.com/UNRsports/bmxt.git"
  },
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "build": "node scripts/build-extension.mjs all",
    "build:chrome": "node scripts/build-extension.mjs chrome",
    "build:firefox": "node scripts/build-extension.mjs firefox",
    "dev": "node scripts/build-wasm.mjs && node scripts/build-background-services.mjs && wxt -c hosts/chrome/wxt.config.ts",
    "dev:firefox": "node scripts/build-wasm.mjs && node scripts/build-background-services.mjs && wxt -c hosts/firefox/wxt.config.ts -b firefox --mv3",
    "package": "node scripts/package-extension.mjs all",
    "package:chrome": "node scripts/package-extension.mjs chrome",
    "package:firefox": "node scripts/package-extension.mjs firefox",
    "postinstall": "wxt prepare -c hosts/chrome/wxt.config.ts",
    "codegen": "node scripts/codegen/run.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:manifest": "node scripts/verify-manifest.mjs",
    "verify:host-blind": "node scripts/verify-host-blind.mjs",
    "verify:wasm-boundary": "node scripts/verify-wasm-boundary.mjs",
    "check:generated": "node scripts/check-generated.mjs",
    "check:no-fetch": "node scripts/check-no-fetch.mjs",
    "sync:completion-fallback": "pnpm run codegen",
    "sync:effect-types": "pnpm run codegen",
    "sync:generated-ts": "pnpm run codegen",
    "new:command": "node scripts/scaffold-command.mjs",
    "test:wasm-boundary": "node scripts/verify-wasm-boundary.mjs",
    "test:e2e:chrome": "BMXT_E2E_BROWSER=chrome node --experimental-strip-types --test-timeout=180000 --test-concurrency=1 --test \"tests/e2e/**/*.test.ts\"",
    "test:e2e:firefox": "BMXT_E2E_BROWSER=firefox node --experimental-strip-types --test-timeout=180000 --test-concurrency=1 --test \"tests/e2e/**/*.test.ts\"",
    "test:e2e:all": "pnpm run test:e2e:chrome && pnpm run test:e2e:firefox",
    "test": "node --experimental-strip-types --test \"tests/unit/**/*.test.ts\" \"tests/unit/**/*.test.mjs\" \"tests/property/**/*.test.ts\"",
    "benchmark:launch": "node scripts/benchmark-launch-perf.mjs"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "pnpm": {
    "overrides": {
      "shell-quote": "1.11.0"
    }
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "@types/selenium-webdriver": "4.1.28",
    "@wxt-dev/module-react": "1.1.3",
    "esbuild": "^0.25.0",
    "fast-check": "4.10.2",
    "linkedom": "0.18.5",
    "prettier": "3.2.4",
    "selenium-webdriver": "4.33.0",
    "typescript": "6.0.3",
    "wxt": "0.20.7"
  }
}
