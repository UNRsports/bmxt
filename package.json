{
  "name": "bmxt_demo",
  "displayName": "__MSG_extensionName__",
  "version": "0.1.1",
  "license": "Apache-2.0",
  "description": "__MSG_extensionDescription__",
  "author": "UNRsports",
  "repository": {
    "type": "git",
    "url": "https://github.com/UNRsports/bmxt.git"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--disable-warning=DEP0040 plasmo dev",
    "build": "NODE_OPTIONS=--disable-warning=DEP0040 plasmo build",
    "package": "NODE_OPTIONS=--disable-warning=DEP0040 plasmo package",
    "codegen": "node scripts/codegen/run.mjs",
    "verify:manifest": "node scripts/verify-manifest.mjs",
    "check:generated": "npm run codegen && git diff --exit-code -- manifest/bmxt-codegen.json wasm/bmxt-core/src/generated wasm/bmxt-core/src/registry/table.rs lib/features/dispatch/effect-types.ts lib/features/dispatch/handlers/apply-dispatch.gen.ts lib/features/builtin-commands/completion-fallback.ts",
    "sync:completion-fallback": "npm run codegen",
    "sync:effect-types": "npm run codegen",
    "sync:generated-ts": "npm run codegen",
    "new:command": "node scripts/scaffold-command.mjs",
    "build:wasm": "npm run codegen && wasm-pack build wasm/bmxt-core --target web --out-dir ../../assets/wasm/bmxt-core",
    "dev:fresh": "npm run build:wasm && NODE_OPTIONS=--disable-warning=DEP0040 plasmo dev"
  },
  "dependencies": {
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "prettier": "3.2.4",
    "typescript": "5.3.3"
  },
  "manifest": {
    "name": "__MSG_extensionName__",
    "default_locale": "en",
    "permissions": [
      "tabs",
      "tabGroups",
      "storage",
      "windows"
    ],
    "content_security_policy": {
      "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
    },
    "commands": {
      "launch-bmxt": {
        "suggested_key": {
          "default": "Shift+Alt+C",
          "mac": "Shift+Alt+C"
        },
        "description": "__MSG_commandLaunchBmxt__",
        "global": true
      }
    }
  }
}
