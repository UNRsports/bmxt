{
  "name": "bmxt_demo",
  "displayName": "__MSG_extensionName__",
  "version": "0.3.5",
  "license": "Apache-2.0",
  "description": "__MSG_extensionDescription__",
  "author": "UNRsports",
  "repository": {
    "type": "git",
    "url": "https://github.com/UNRsports/bmxt.git"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--disable-warning=DEP0040 plasmo dev",
    "build": "NODE_OPTIONS=--disable-warning=DEP0040 plasmo build",
    "package": "NODE_OPTIONS=--disable-warning=DEP0040 plasmo package",
    "codegen": "node scripts/codegen/run.mjs",
    "verify:manifest": "node scripts/verify-manifest.mjs",
    "check:generated": "npm run codegen && git diff --exit-code -- manifest/bmxt-codegen.json lib/features/bmxt-core/registry/table.gen.ts lib/features/dispatch/effect-types.ts lib/features/dispatch/handlers/apply-dispatch.gen.ts lib/features/builtin-commands/completion-fallback.ts lib/features/builtin-commands/command-subcommands.gen.ts",
    "check:no-fetch": "node scripts/check-no-fetch.mjs",
    "sync:completion-fallback": "npm run codegen",
    "sync:effect-types": "npm run codegen",
    "sync:generated-ts": "npm run codegen",
    "new:command": "node scripts/scaffold-command.mjs"
  },
  "dependencies": {
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "prettier": "3.2.4",
    "typescript": "5.3.3"
  },
  "manifest": {
    "name": "__MSG_extensionName__",
    "default_locale": "en",
    "permissions": [
      "tabs",
      "tabGroups",
      "storage",
      "windows",
      "scripting",
      "history",
      "bookmarks"
    ],
    "optional_host_permissions": ["http://*/*", "https://*/*"],
    "content_security_policy": {
      "extension_pages": "default-src 'self'; script-src 'self' http://127.0.0.1:* http://localhost:*; object-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self';"
    },
    "commands": {
      "launch-bmxt": {
        "suggested_key": {
          "default": "Shift+Alt+C",
          "mac": "Shift+Alt+C"
        },
        "description": "__MSG_commandLaunchBmxt__",
        "global": true
      }
    }
  }
}
