{
  "name": "bmxt_demo",
  "displayName": "__MSG_extensionName__",
  "version": "0.8.4",
  "license": "Apache-2.0",
  "description": "__MSG_extensionDescription__",
  "author": "UNRsports",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "repository": {
    "type": "git",
    "url": "https://github.com/UNRsports/bmxt.git"
  },
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "build": "node scripts/build-wasm.mjs && node scripts/build-background-services.mjs && wxt build",
    "dev": "node scripts/build-wasm.mjs && node scripts/build-background-services.mjs && wxt",
    "package": "node scripts/build-wasm.mjs && node scripts/build-background-services.mjs && wxt zip",
    "postinstall": "wxt prepare",
    "codegen": "node scripts/codegen/run.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:manifest": "node scripts/verify-manifest.mjs",
    "verify:host-blind": "node scripts/verify-host-blind.mjs",
    "verify:wasm-boundary": "node scripts/verify-wasm-boundary.mjs",
    "check:generated": "pnpm run codegen && git diff --exit-code -- manifest/bmxt-codegen.json lib/features/bmxt-core/registry/table.gen.ts lib/features/dispatch/effect-types.ts lib/features/dispatch/ui-action-types.ts lib/features/dispatch/handlers/apply-dispatch.gen.ts lib/features/builtin-commands/completion-fallback.ts lib/features/builtin-commands/command-subcommands.gen.ts crates/bmxt-core/src/generated/chrome_effect.rs crates/bmxt-core/src/generated/ui_action.rs crates/bmxt-core/src/generated/registry_table.rs",
    "check:no-fetch": "node scripts/check-no-fetch.mjs",
    "sync:completion-fallback": "pnpm run codegen",
    "sync:effect-types": "pnpm run codegen",
    "sync:generated-ts": "pnpm run codegen",
    "new:command": "node scripts/scaffold-command.mjs",
    "test:wasm-boundary": "node scripts/verify-wasm-boundary.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test": "node --experimental-strip-types --test \"lib/**/*.test.ts\" \"scripts/**/*.test.mjs\"",
    "benchmark:launch": "node scripts/benchmark-launch-perf.mjs"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "pnpm": {
    "overrides": {
      "shell-quote": "1.8.4"
    }
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@playwright/test": "1.51.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "@wxt-dev/module-react": "1.1.3",
    "esbuild": "^0.25.0",
    "linkedom": "0.18.5",
    "prettier": "3.2.4",
    "typescript": "6.0.3",
    "wxt": "0.20.7"
  }
}
