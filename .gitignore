
# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# --- Dependencies ---
# EN: Ignore anywhere (not only repo-root) so nested installs cannot be committed.
node_modules/
/.pnp
.pnp.js
.pnp.*


# --- Package managers（this repo is pnpm-only）---
.pnpm-store/
package-lock.json
yarn.lock
npm-shrinkwrap.json
# Do not commit registry tokens in .npmrc (save-exact=true is committed)


# --- Cursor（ローカル状態・MCP 等。ルートの .cursorrules と .cursor/skills/ は対象外）---
.cursor/*
!.cursor/skills/
!.cursor/skills/**


# --- Build / bundler（WXT, Vite, 汎用）---
.output/
out/
dist/
.cache/
.wxt/
shared/.wxt/
shared/public/background-services.js
shared/public/background-services.mjs


# --- Testing / coverage ---
/coverage
.nyc_output
*.lcov
*.cov
# Playwright artifacts (root cwd defaults and tests/ config-local)
test-results/
playwright-report/
blob-report/
playwright/.cache/


# --- TypeScript ---
.tsbuildinfo
*.tsbuildinfo


# --- Lint / format caches ---
.eslintcache
.prettier-cache


# --- Debug / package manager logs ---
pnpm-debug.log*
lerna-debug.log*
*.log


# --- Local env（秘密・個人用）---
.env
.env.*
.env*.local
!.env.example
!.env.sample


# --- OS ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*~
*.orig


# --- Editor / IDE ---
.vscode/
.idea/
*.swp
*.swo


# --- Keys & certificates（署名・ストア・HTTPS）---
*.pem
*.key
*.p12
*.pfx


# --- Rust / Cargo（wasm 含む。再現可能なビルドツリー）---
**/target/

# Copied by build:wasm for the extension package (canonical: shared/lib/wasm/bmxt-core/)
/shared/public/bmxt_core_bg.wasm


# --- Rust / LLVM coverage ---
*.profraw
*.profdata


# --- Browser extension ---
*.crx
*.xpi
*.signed.xpi
web-ext-artifacts/
# EN: Unsigned/local XPI outside `.output/` (AMO zips stay under ignored `.output/`).


# --- Misc packaged artifacts ---
*.tgz
