
# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# --- Dependencies ---
/node_modules
/.pnp
.pnp.js
.pnp.*


# --- pnpm ---
.pnpm-store/
# Do not commit registry tokens in .npmrc (save-exact=true is committed)


# --- Cursor（ローカル状態・MCP 等。ルートの .cursorrules と .cursor/skills/ は対象外）---
.cursor/*
!.cursor/skills/
!.cursor/skills/**


# --- Build / bundler（WXT, Vite, 汎用）---
.output/
out/
dist/
.cache/
.wxt/
public/background-services.js


# --- Testing / coverage ---
/coverage
.nyc_output
*.lcov
*.cov


# --- TypeScript ---
.tsbuildinfo
*.tsbuildinfo


# --- Lint / format caches ---
.eslintcache
.prettier-cache


# --- Debug / package manager logs ---
pnpm-debug.log*
lerna-debug.log*
*.log


# --- Local env（秘密・個人用）---
.env
.env.*
.env*.local
!.env.example
!.env.sample


# --- OS ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*~
*.orig


# --- Editor / IDE ---
.vscode/
.idea/
*.swp
*.swo


# --- Keys & certificates（署名・ストア・HTTPS）---
*.pem
*.key
*.p12
*.pfx


# --- Rust / Cargo（wasm 含む。再現可能なビルドツリー）---
**/target/

# Copied by build:wasm for the extension package (canonical: lib/wasm/bmxt-core/)
/public/bmxt_core_bg.wasm


# --- Rust / LLVM coverage ---
*.profraw
*.profdata


# --- Browser extension ---
*.crx
*.signed.xpi
web-ext-artifacts/


# --- Misc packaged artifacts ---
*.tgz
